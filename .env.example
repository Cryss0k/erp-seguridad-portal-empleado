# Copiar como ".env" (excluido por .gitignore) o ejecutar: python generar_env.py
# Llave de sesión:   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Llave de cifrado:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# 1 solo en desarrollo local. Nunca en producción.
FLASK_DEBUG=0
# 1 cuando se sirva por HTTPS (marca la cookie de sesión como Secure y activa HSTS)
COOKIE_SECURE=0
